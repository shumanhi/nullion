  "version": 1,
  "scope": "tests/e2e/test_live_stage*.py; reviewed developer test metadata, never product intent routing",
  "categories": {
    "latency": {
      "title": "Plain chat and latency",
      "purpose": "First-response timing, model-call counts, startup and ordinary-turn fast paths."
    },
    "context": {
      "title": "Context, memory and retained evidence",
      "purpose": "Follow-ups, profile facts, history, numbered choices, compaction and exact retained references."
    },
    "research": {
      "title": "Research and source accuracy",
      "purpose": "Search coverage, bounded research, recommendations, prices, source links and missing facts."
    },
    "browser": {
      "title": "Browser lifecycle and recovery",
      "purpose": "Desktop attachment, navigation, screenshots, native delegation, owned tabs and recovery."
    },
    "artifacts": {
      "title": "Files and generated deliverables",
      "purpose": "Document creation, format fidelity, selected versions, downloadable bytes and artifact reuse."
    },
    "execution": {
      "title": "Code Mode and terminal execution",
      "purpose": "Programs, host modules, projections, reusable tools, unsupported imports and terminal outcomes."
    },
    "scheduler": {
      "title": "Scheduled jobs and live trackers",
      "purpose": "Owned job changes, cancellation, finite lifetimes, conditions, alert delivery and saved-run recovery."
    },
    "consent": {
      "title": "Account access and approvals",
      "purpose": "Source consent, read-only account boundaries, explicit choices and action approvals."
    },
    "presentation": {
      "title": "Progress, rendering and delivery",
      "purpose": "Shared status, compact reports, exact captions, Web history, sockets and reload behavior."
    },
    "harness": {
      "title": "Local test infrastructure",
      "purpose": "Deterministic transport, provider-stop controls and static catalogue invariants; no live model requests."
    }
  },
  "kinds": {
    "live_workflow": "A running stage workflow that can consume model or tool quota. One case may send multiple chat requests.",
