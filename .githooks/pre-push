#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
while IFS= read -r git_env_name; do
  unset "$git_env_name"
done < <(git rev-parse --local-env-vars)
echo "pre-push: running checkout-local unit tests and coverage in Docker..."
"$ROOT/scripts/test-docker.sh"
echo "pre-push: running checkout-local E2E tests in Docker..."
"$ROOT/scripts/e2e-docker.sh"
